<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. The operator says "Gam Gooey": Siri couldn't find an app
	     named "GamGUI" from that (2026-10-10), so the spoken forms are the app's alternative names, and
	     VoiceOver says the name the same way. At most three alternative names. -->
	<key>CFBundleSpokenName</key>
	<string>Gam Gooey</string>
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Gam Gooey</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>gam gooey</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Gamgooey</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Gam GUI</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>gam gee you eye</string>
		</dict>
	</array>
</dict>
</plist>
