<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. The app is "GAM GUI" on screen and to Siri (operator,
	     2026-10-10): Siri hears the operator's "Gam Gooey" as "GAM GUI" and matches only an app's
	     localized display name (it ignored INAlternativeAppNames on the Mac). The name is localized
	     (App/en.lproj/InfoPlist.strings), so Finder, the Dock and Spotlight show it while the bundle and
	     its executable keep the product name. The unlocalized display name must stay the bundle's file
	     name (the INFOPLIST_KEY_CFBundleDisplayName build setting): macOS treats any other as a rename
	     by the user and shows the file name. VoiceOver says the name as the operator does. -->
	<key>LSHasLocalizedDisplayName</key>
	<true/>
	<key>CFBundleSpokenName</key>
	<string>Gam Gooey</string>
</dict>
</plist>
