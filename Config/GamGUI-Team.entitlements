<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Team-signed builds only (selected by Config/Local.xcconfig). The data-protection Keychain needs an
     access group, and claiming one makes Xcode provision the app (application-identifier). Ad-hoc
     builds use GamGUI.entitlements, which claims nothing. -->
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
