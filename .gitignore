# Xcode / SwiftPM build output
DerivedData/
.build/
.swiftpm/
*.xcresult
xcuserdata/
*.xcuserstate

# Vendored GAM7 binary and support files: fetched by scripts/fetch_gam.sh against the pin, never
# committed. The derived browse catalog, the version stamp and GAM's license are committed.
Vendor/gam7/*
!Vendor/gam7/VERSION
!Vendor/gam7/LICENSE
!Vendor/gam7/command_catalog.json

# Secrets / local runtime state must never be committed (bare names too).
oauth2service.json
*.oauth2service.json
oauth2.txt
client_secrets.json
*.local

# Local agent tooling: settings, hooks and the private-terms list stay local; shared skills/agents
# are tracked.
.claude/*
!.claude/skills/
!.claude/agents/

# Python caches from the scripts
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Per-developer signing team (see Config/Base.xcconfig)
Config/Local.xcconfig
build/
